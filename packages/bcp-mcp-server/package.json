{
  "name": "@bit-context-protocol/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for the Bit Context Protocol — stdio and HTTP transports with proxy support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mega-blastoise/bit-context-protocol.git",
    "directory": "packages/bcp-mcp-server"
  },
  "homepage": "https://github.com/mega-blastoise/bit-context-protocol/tree/main/packages/bcp-mcp-server",
  "bugs": {
    "url": "https://github.com/mega-blastoise/bit-context-protocol/issues"
  },
  "contributors": [
    {
      "email": "rustycloud42@protonmail.com",
      "name": "Nick G.",
      "url": "https://github.com/mega-blastoise"
    }
  ],
  "keywords": [
    "mcp",
    "bcp",
    "context",
    "model-context-protocol",
    "ai",
    "bun"
  ],
  "bin": {
    "bcp-mcp-server": "dist/bcp-mcp-server.bun.js",
    "bun-bcp-mcp-server": "bin/bcp-mcp-server.ts"
  },
  "exports": {
    ".": {
      "bun": "./dist/bcp-mcp-server.bun.js",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/bcp-mcp-server.js",
      "default": "./dist/bcp-mcp-server.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "start:http": "bun run src/index.ts --transport http",
    "prebuild": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "bun build/index.ts",
    "build": "bun run build:bundle && bun run build:types",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "supports-color": "^10.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/debug": "^4.1.12",
    "typescript": "^5.9.3"
  }
}
