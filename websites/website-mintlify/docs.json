              "concepts/compression",
              "concepts/content-addressing",
              "concepts/token-budget",
              "concepts/forward-compatibility"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/encoding",
              "guides/decoding",
              "guides/rendering",
              "guides/cli",
              "guides/mcp-server",
              "guides/manifest-format"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Crate Reference",
            "pages": [
              "reference/crate-bcp-wire",
              "reference/crate-bcp-types",
